<script>
(() => {
    const section = document.getElementById("before-after");
    if (!section) return;

    // Укажите фотографии для каждой пары.
    const results = [
        {
           before: "file:///Users/anastasia/Library/Containers/ru.keepcoder.Telegram/Data/tmp/IMAGE%202026-10-12%2000:34:48.jpg",
            after: "file:///Users/anastasia/Library/Containers/ru.keepcoder.Telegram/Data/tmp/IMAGE%202026-10-12%2000:35:52.jpg"
        },
        {
            before: "file:///Users/anastasia/Library/Containers/ru.keepcoder.Telegram/Data/tmp/IMAGE%202026-10-12%2000:36:37.jpg", // Ваше второе фото ДО
            after: "file:///Users/anastasia/Library/Containers/ru.keepcoder.Telegram/Data/tmp/IMAGE%202026-10-12%2000:36:43.jpg"    // Ваше второе фото ПОСЛЕ
        },
        {
            before: "file:///Users/anastasia/Library/Containers/ru.keepcoder.Telegram/Data/tmp/IMAGE%202026-10-12%2000:37:42.jpg", // Ваше третье фото ДО
            after: "file:///Users/anastasia/Library/Containers/ru.keepcoder.Telegram/Data/tmp/IMAGE%202026-10-12%2000:37:35.jpg"    // Ваше третье фото ПОСЛЕ
        }
    ];

    const slider = section.querySelector("[data-ba-slider]");
    const handle = section.querySelector("[data-ba-handle]");
    const before = section.querySelector("[data-ba-before]");
    const after = section.querySelector("[data-ba-after]");
    const counter = section.querySelector("[data-ba-counter]");
    const positions = results.map(() => 50);
    let current = 0;
    let activePointer = null;

    function setPosition(value) {
        const position = Math.round(Math.max(0, Math.min(100, value)));
        positions[current] = position;
        slider.style.setProperty("--split", position + "%");
        handle.setAttribute("aria-valuenow", String(position));
        handle.setAttribute("aria-valuetext", position + "% до, " + (100 - position) + "% после");
    }

    function showResult(index) {
        current = (index + results.length) % results.length;
        before.src = results[current].before;
        after.src = results[current].after;
        before.alt = "До уборки — результат " + (current + 1);
        after.alt = "После уборки — результат " + (current + 1);
        counter.textContent = (current + 1) + " / " + results.length;
        // При переключении результата ползунок начинается с середины.
        setPosition(50);
    }

    section.querySelector("[data-ba-prev]").addEventListener("click", () => showResult(current - 1));
    section.querySelector("[data-ba-next]").addEventListener("click", () => showResult(current + 1));

    function moveSlider(event) {
        const rect = slider.getBoundingClientRect();
        if (rect.width) setPosition((event.clientX - rect.left) / rect.width * 100);
    }

    slider.addEventListener("pointerdown", event => {
        if (!event.isPrimary || event.button !== 0) return;
        activePointer = event.pointerId;
        slider.setPointerCapture(event.pointerId);
        handle.focus({ preventScroll: true });
        moveSlider(event);
    });
    slider.addEventListener("pointermove", event => {
        if (event.pointerId === activePointer) moveSlider(event);
    });
    ["pointerup", "pointercancel", "lostpointercapture"].forEach(type => {
        slider.addEventListener(type, event => {
            if (event.pointerId === activePointer) activePointer = null;
        });
    });

    handle.addEventListener("keydown", event => {
        const keys = {
            ArrowLeft: positions[current] - 5,
            ArrowDown: positions[current] - 5,
            ArrowRight: positions[current] + 5,
            ArrowUp: positions[current] + 5,
            Home: 0,
            End: 100
        };
        if (Object.prototype.hasOwnProperty.call(keys, event.key)) {
            event.preventDefault();
            setPosition(keys[event.key]);
        }
    });

    showResult(0);
})();
</script>


