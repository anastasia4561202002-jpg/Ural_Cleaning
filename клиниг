     <!-- JavaScript logic -->
    <script>
        // Calculator Logic
        let currentType = 'standard';
        const prices = { standard: 50, general: 90, repair: 120, windows: 40 };

        function setCleanType(type, btn) {
            currentType = type;
            document.querySelectorAll('.type-btn').forEach(b => {
                b.classList.remove('bg-sky-500', 'text-white');
                b.classList.add('bg-white', 'text-slate-700');
            });
            btn.classList.add('bg-sky-500', 'text-white');
            btn.classList.remove('bg-white', 'text-slate-700');
            updateCalc();
        }

        function updateCalc() {
            const area = document.getElementById('area-slider').value;
            document.getElementById('area-val').innerText = area;

            let base = area * prices[currentType];
            if (document.getElementById('ext-fridge').checked) base += 600;
            if (document.getElementById('ext-oven').checked) base += 500;
            if (document.getElementById('ext-balcony').checked) base += 1000;

            const finalPrice = Math.round(base * 0.9);

            document.getElementById('base-price').innerText = base.toLocaleString() + ' ₽';
            document.getElementById('total-price').innerText = finalPrice.toLocaleString() + ' ₽';
            document.getElementById('btn-price').innerText = finalPrice.toLocaleString() + ' ₽';
        }

        // FAQ Toggle
        function toggleFaq(btn) {
            const content = btn.nextElementSibling;
            const icon = btn.querySelector('i');
content.classList.toggle('hidden');
            icon.classList.toggle('rotate-180');
        }

        // Modal Logic
        function openModal(serviceName) {
            if(serviceName) document.getElementById('modal-title').innerText = serviceName;
            document.getElementById('modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('modal').classList.add('hidden');
        }

        function submitForm(e) {
            e.preventDefault();
            alert('Спасибо! Ваша заявка успешно отправлена. Менеджер свяжется с вами!');
            closeModal();
        }

        // Before/After Slider Drag
        const container = document.getElementById('slider-container');
        const handle = document.getElementById('slider-handle');
        const afterImg = document.getElementById('after-img');
        const afterImgSrc = document.getElementById('after-img-src');

        function setSliderPos(x) {
            const rect = container.getBoundingClientRect();
            let pos = ((x - rect.left) / rect.width) * 100;
            if (pos < 0) pos = 0;
            if (pos > 100) pos = 100;
            handle.style.left = pos + '%';
            afterImg.style.width = pos + '%';
            afterImgSrc.style.width = container.offsetWidth + 'px';
        }

        let isDragging = false;
        container.addEventListener('mousedown', () => isDragging = true);
        window.addEventListener('mouseup', () => isDragging = false);
        window.addEventListener('mousemove', (e) => {
            if (isDragging) setSliderPos(e.clientX);
        });

        // Responsive adjustment for before/after
        window.addEventListener('resize', () => {
            afterImgSrc.style.width = container.offsetWidth + 'px';
        });
        afterImgSrc.style.width = container.offsetWidth + 'px';
    </script>
